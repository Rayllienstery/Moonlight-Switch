<brls:Box
    width="auto"
    height="auto">

    <brls:ScrollingFrame
        width="auto"
        height="auto"
        axis="column"
        alignItems="stretch"
        grow="1.0">

        <brls:Box
            width="10000"
            height="auto"
            axis="column"
            alignItems="stretch"
            paddingTop="@style/brls/tab_details/padding_top"
            paddingRight="@style/brls/tab_details/padding_right"
            paddingBottom="@style/brls/tab_details/padding_bottom"
            paddingLeft="@style/brls/tab_details/padding_left">

            <brls:Header
                title="@i18n/tweaks/frame_buffer"/>

            <brls:SelectorCell
                id="frame_queue"/>

            <brls:Header
                title="@i18n/tweaks/link_test"
                paddingTop="60"
                lineTop="1px"/>

            <brls:SelectorCell
                id="link_host"/>

            <brls:DetailCell
                id="link_test"/>

        </brls:Box>
    </brls:ScrollingFrame>
</brls:Box>
